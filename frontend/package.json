{
  "name": "disco-incognito",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest --run",
    "test:watch": "vitest",
    "test:e2e:login": "node tests/e2e/login-flow.test.mjs",
    "test:e2e:rooms": "node tests/e2e/room-selection.test.mjs",
    "test:e2e:game": "node tests/e2e/game-flow.test.mjs",
    "test:e2e": "npm run test:e2e:login && npm run test:e2e:rooms && npm run test:e2e:game",
    "test:screenshots": "node tests/e2e/screenshot-runner.mjs",
    "test:e2e:screenshots": "node tests/e2e/screenshot-runner.mjs",
    "test:e2e:screenshots:update": "node tests/e2e/screenshot-runner.mjs --update-screenshots",
    "test": "npm run test:unit && npm run test:e2e",
    "lint": "eslint . --ext .ts,.vue"
  },
  "dependencies": {
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.8",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tsconfig/node18-strictest-esm": "^1.0.1",
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "4.5.0",
    "@vitest/ui": "^1.4.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.5",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "jsdom": "^24.0.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.35",
    "puppeteer": "^24.23.0",
    "tailwindcss": "3.4.0",
    "typescript": "^5.4.3",
    "vite": "4.5.0",
    "vitest": "^1.4.0"
  }
}
